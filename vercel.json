{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/claude.ts": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/ring.html",
      "destination": "/studio.html",
      "permanent": false
    },
    {
      "source": "/cad.html",
      "destination": "/studio.html",
      "permanent": false
    }
  ]
}
