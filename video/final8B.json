 "voice": [
  {
   "n": 1,
   "at": 0.5,
   "text": "私は、彫金の職人です。",
   "own": "voice/sim8/_own/n1.wav",
   "own_raw": 2.581,
   "own_dur": 2.581
  },
  {
   "n": 2,
   "at": 8.5,
   "text": "作れるかどうかの判断は、職人の頭の中にある。",
   "own": "voice/sim8/_own/n2.wav",
   "own_raw": 4.202667,
   "own_dur": 4.202667
  },
  {
   "n": 3,
   "at": 20.5,
   "text": "継ぐは、それを蓄えます。",
   "own": "voice/sim8/_own/n3.wav",
   "own_raw": 1.770667,
   "own_dur": 1.770667
  },
  {
   "n": 4,
   "at": 25,
   "text": "作れない、と何度もデザインに戻ってくる。",
   "own": "voice/sim8/_own/n4.wav",
   "own_raw": 3.093,
   "own_dur": 3.093
  },
  {
   "n": 5,
   "at": 33,
   "text": "継ぐなら、デザインの時点で、作れるか分かる。",
   "own": "voice/sim8/_own/n5.wav",
   "own_raw": 3.093,
   "own_dur": 3.093
  },
  {
   "n": 6,
   "at": 41,
   "text": "ネットの情報だけだと、不自然な形になる。",
   "own": "voice/sim8/_own/n6.wav",
   "own_raw": 3.605,
   "own_dur": 3.605
  },
  {
   "n": 7,
   "at": 49,
   "text": "職人の言葉を、そのまま入れる。",
   "own": "voice/sim8/_own/n7.wav",
   "own_raw": 2.453,
   "own_dur": 2.453
  },
  {
   "n": 8,
   "at": 57,
   "text": "Claude が、それを決まりにする。",
   "own": "voice/sim8/_own/n8.wav",
   "own_raw": 2.176,
   "own_dur": 2.176
  },
  {
   "n": 9,
   "at": 68.5,
   "text": "職人の言葉から、Claude が、爪も石座も直していった。",
   "own": "voice/sim8/_own/n9.wav",
   "own_raw": 4.565,
   "own_dur": 4.565
  },
  {
   "n": 10,
   "at": 80.5,
   "text": "次の設計から、その決まりで組む。",
   "own": "voice/sim8/_own/n10.wav",
   "own_raw": 2.858667,
   "own_dur": 2.858667
  },
  {
   "n": 11,
   "at": 89,
   "text": "帳面に足りない所は、Claude が聞きに来る。",
   "own": "voice/sim8/_own/n11.wav",
   "own_raw": 3.370667,
   "own_dur": 3.370667
  },
  {
   "n": 12,
   "at": 103,
   "text": "答えると、それが決まりになる。",
   "own": "voice/sim8/_own/n12.wav",
   "own_raw": 2.304,
   "own_dur": 2.304
  },
  {
   "n": 14,
   "at": 113,
   "text": "作れない所は、赤く光る。直せば、消える。",
   "own": "voice/sim8/_own/n14.wav",
   "own_raw": 3.392,
   "own_dur": 3.392
  },
  {
   "n": 15,
   "at": 124.5,
   "text": "鋳造でも、手作りでも、仕上げまで。",
   "own": "voice/sim8/_own/n15.wav",
   "own_raw": 2.624,
   "own_dur": 2.624
  },
  {
   "n": 16,
   "at": 137.5,
   "text": "職人の言葉は、その工程に残る。",
   "own": "voice/sim8/_own/n16.wav",
   "own_raw": 3.093,
   "own_dur": 3.093
  },
  {
   "n": 17,
   "at": 149,
   "text": "学校では、独自のデザインは、先生に聞くしかない。",
   "own": "voice/sim8/_own/n17.wav",
   "own_raw": 3.882667,
   "own_dur": 3.882667
  },
  {
   "n": 18,
   "at": 158,
   "text": "生徒は多く、先生は少ない。長いときは 1 時間待つ。",
   "own": "voice/sim8/_own/n18.wav",
   "own_raw": 4.522667,
   "own_dur": 4.522667
  },
  {
   "n": 19,
   "at": 169,
   "text": "継ぐなら、すぐ答えが出る。",
   "own": "voice/sim8/_own/n19.wav",
   "own_raw": 1.877,
   "own_dur": 1.877
  },
  {
   "n": 20,
   "at": 177,
   "text": "工房では、手順や数字は継ぐに聞く。",
   "own": "voice/sim8/_own/n20.wav",
   "own_raw": 2.816,
   "own_dur": 2.816
  },
  {
   "n": 21,
   "at": 185,
   "text": "先輩には、まだ言葉にできない手の感覚を。",
   "own": "voice/sim8/_own/n21.wav",
   "own_raw": 3.648,
   "own_dur": 3.648
  },
  {
   "n": 22,
   "at": 193,
   "text": "そして、伝統工芸の継承にも使える。",
   "own": "voice/sim8/_own/n22.wav",
   "own_raw": 2.965,
   "own_dur": 2.965
  },
  {
   "n": 23,
   "at": 201,
   "text": "伝統的工芸品の作り手は、約 6 割減った。",
   "own": "voice/sim8/_own/n23.wav",
   "own_raw": 4.309,
   "own_dur": 4.309
  },
  {
   "n": 24,
   "at": 213,
   "text": "20 年に一度しか、受け継ぐ機会がない技もある。",
   "own": "voice/sim8/_own/n24.wav",
   "own_raw": 3.989,
   "own_dur": 3.989
  },
  {
   "n": 25,
   "at": 225,
   "text": "こうした彫金の技も、継ぐで、次へ残せる。",
   "own": "voice/sim8/_own/n25.wav",
   "own_raw": 3.648,
   "own_dur": 3.648
  },
  {
   "n": 26,
   "at": 232.5,
   "text": "もし、途絶えてしまっても、継ぐなら、復元を試みることができる。",
   "own": "voice/sim8/_own/n26.wav",
   "own_raw": 5.098667,
   "own_dur": 5.098667
  },
  {
   "n": 27,
   "at": 245,
   "text": "たとえば、木目金という、江戸時代の刀の飾りの技がある。",
   "own": "voice/sim8/_own/n27.wav",
   "own_raw": 5.056,
   "own_dur": 5.056
  },
  {
   "n": 28,
   "at": 257,
   "text": "一時途絶えたとされ、のちに復元された。",
   "own": "voice/sim8/_own/n28.wav",
   "own_raw": 3.306667,
   "own_dur": 3.306667
  },
  {
   "n": 29,
   "at": 265,
   "text": "作り方を隠して、手がかりだけを渡す。",
   "own": "voice/sim8/_own/n29.wav",
   "own_raw": 3.264,
   "own_dur": 3.264
  },
  {
   "n": 30,
   "at": 273,
   "text": "Claude が、作り方の復元を試みる。",
   "own": "voice/sim8/_own/n30.wav",
   "own_raw": 3.072,
   "own_dur": 3.072
  },
  {
   "n": 31,
   "at": 281,
   "text": "隠しておいた、本当の 11 の手順と比べる。",
   "own": "voice/sim8/_own/n31.wav",
   "own_raw": 3.52,
   "own_dur": 3.52
  },
  {
   "n": 32,
   "at": 292.5,
   "text": "11 のうち 9 に、たどり着いた。",
   "own": "voice/sim8/_own/n32.wav",
   "own_raw": 2.368,
   "own_dur": 2.368
  },
  {
   "n": 33,
   "at": 305,
   "text": "失われた技も、手がかりから組み立て直せるかもしれない。",
   "own": "voice/sim8/_own/n33.wav",
   "own_raw": 4.629,
   "own_dur": 4.629
  },
  {
   "n": 34,
   "at": 317,
   "text": "職人の判断を、蓄える。",
   "own": "voice/sim8/_own/n34.wav",
   "own_raw": 1.898667,
   "own_dur": 1.898667
  },
  {
   "n": 35,
   "at": 324,
   "text": "失われた技まで、組み立て直す。",
   "own": "voice/sim8/_own/n35.wav",
   "own_raw": 2.688,
   "own_dur": 2.688
  },
  {
   "n": 36,
   "at": 334.4,
   "text": "継ぐ。",
   "own": "voice/sim8/_own/n36.wav",
   "own_raw": 0.715,
   "own_dur": 0.715
  },
  {
   "n": 37,
   "at": 337.5,
   "text": "このアプリも、私が Claude Code と作りました。",
   "own": "voice/sim8/_own/n37.wav",
