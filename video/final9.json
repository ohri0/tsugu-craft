 "voice": [
  {
   "n": 1,
   "at": 1.7,
   "dur": 2.347,
   "text": "私は、彫金の職人です。",
   "file": "voice/sim9/n1.wav"
  },
  {
   "n": 2,
   "at": 4.115,
   "dur": 4.416,
   "text": "作れるかどうかの判断は、職人の頭の中にあります。",
   "file": "voice/sim9/n2.wav"
  },
  {
   "n": 3,
   "at": 8.615,
   "dur": 3.072,
   "text": "職人がいなくなれば、その判断も消えます。",
   "file": "voice/sim9/n3.wav"
  },
  {
   "n": 4,
   "at": 12.876,
   "dur": 2.56,
   "text": "継ぐ。職人の判断を、次の人へ。",
   "file": "voice/sim9/n4.wav"
  },
  {
   "n": 5,
   "at": 15.842,
   "dur": 2.624,
   "text": "継ぐは、職人の言葉を受け取ります。",
   "file": "voice/sim9/n5.wav"
  },
  {
   "n": 6,
   "at": 19.015,
   "dur": 3.648,
   "text": "Claude が読み取って、数字つきの決まりの案にします。",
   "file": "voice/sim9/n6.wav"
  },
  {
   "n": 7,
   "at": 23.099,
   "dur": 3.051,
   "text": "職人が見てよければ、帳面に残ります。",
   "file": "voice/sim9/n7.wav"
  },
  {
   "n": 8,
   "at": 26.576,
   "dur": 2.197,
   "text": "決まりは、工房ごとに持てます。",
   "file": "voice/sim9/n8.wav"
  },
  {
   "n": 9,
   "at": 29.397,
   "dur": 3.435,
   "text": "残した判断は、次の人に渡っていきます。",
   "file": "voice/sim9/n9.wav"
  },
  {
   "n": 10,
   "at": 32.976,
   "dur": 1.493,
   "text": "まず、デザインする人へ。",
   "file": "voice/sim9/n10.wav"
  },
  {
   "n": 11,
   "at": 35.103,
   "dur": 4.075,
   "text": "作れない、と制作から何度も戻ってくることがあります。",
   "file": "voice/sim9/n11.wav"
  },
  {
   "n": 12,
   "at": 40.503,
   "dur": 3.179,
   "text": "継ぐがあれば、戻りは、ごく少なくなります。",
   "file": "voice/sim9/n12.wav"
  },
  {
   "n": 13,
   "at": 44.863,
   "dur": 4.651,
   "text": "残した言葉から、Claude が、次の石の作りを推測します。",
   "file": "voice/sim9/n13.wav"
  },
  {
   "n": 14,
   "at": 50.297,
   "dur": 4.693,
   "text": "石は、手持ちの石の写真でも、よくある形からでも選べます。",
   "file": "voice/sim9/n14.wav"
  },
  {
   "n": 15,
   "at": 55.297,
   "dur": 6.208,
   "text": "「ゴシックな感じ」と言葉で頼むだけで、職人の決まりを守った形になります。",
   "file": "voice/sim9/n15.wav"
  },
  {
   "n": 16,
   "at": 62.864,
   "dur": 2.752,
   "text": "分からない所は、職人に聞きます。",
   "file": "voice/sim9/n16.wav"
  },
  {
   "n": 17,
   "at": 66.488,
   "dur": 2.411,
   "text": "答えると、それが決まりになります。",
   "file": "voice/sim9/n17.wav"
  },
  {
   "n": 18,
   "at": 69.449,
   "dur": 3.328,
   "text": "作れない所は、職人の言葉で教えます。",
   "file": "voice/sim9/n18.wav"
  },
  {
   "n": 19,
   "at": 73.14,
   "dur": 2.795,
   "text": "なぜ作れないのか、どう直せばよいのかを。",
   "file": "voice/sim9/n19.wav"
  },
  {
   "n": 20,
   "at": 76.731,
   "dur": 5.397,
   "text": "3D モデルをもとに、鋳造でも鍛造でも、作り方まで提案します。",
   "file": "voice/sim9/n20.wav"
  },
  {
   "n": 21,
   "at": 82.649,
   "dur": 1.429,
   "text": "次に、学ぶ人へ。",
   "file": "voice/sim9/n21.wav"
  },
  {
   "n": 22,
   "at": 84.597,
   "dur": 4.032,
   "text": "学校では、独自のデザインは、先生に聞くしかありません。",
   "file": "voice/sim9/n22.wav"
  },
  {
   "n": 23,
   "at": 88.919,
   "dur": 2.176,
   "text": "長いときは 1 時間待ちます。",
   "file": "voice/sim9/n23.wav"
  },
  {
   "n": 24,
   "at": 91.424,
   "dur": 1.877,
   "text": "継ぐなら、すぐ答えが出ます。",
   "file": "voice/sim9/n24.wav"
  },
  {
   "n": 25,
   "at": 94.264,
   "dur": 4.672,
   "text": "工房では、先輩の手を止めずに、手順や数字を確かめられます。",
   "file": "voice/sim9/n25.wav"
  },
  {
   "n": 26,
   "at": 98.891,
   "dur": 4.075,
   "text": "先輩には、まだ言葉にできない手の感覚を聞きます。",
   "file": "voice/sim9/n26.wav"
  },
  {
   "n": 27,
   "at": 103.115,
   "dur": 1.579,
   "text": "そして、次の時代へ。",
   "file": "voice/sim9/n27.wav"
  },
  {
   "n": 28,
   "at": 105.158,
   "dur": 4.352,
   "text": "伝統的工芸品の作り手は、約 6 割減りました。",
   "file": "voice/sim9/n28.wav"
  },
  {
   "n": 29,
   "at": 109.897,
   "dur": 4.011,
   "text": "20 年に一度しか、受け継ぐ機会がない技もあります。",
   "file": "voice/sim9/n29.wav"
  },
  {
   "n": 30,
   "at": 114.297,
   "dur": 3.669,
   "text": "こうした彫金の技も、継ぐで、次へ残せます。",
   "file": "voice/sim9/n30.wav"
  },
  {
   "n": 31,
   "at": 118.329,
   "dur": 4.672,
   "text": "職人が答えて、手本を残す。学ぶ人が聞いて、手を比べる。",
   "file": "voice/sim9/n31.wav"
  },
  {
   "n": 32,
   "at": 123.342,
   "dur": 4.096,
   "text": "もし途絶えてしまっても、復元を試みることができます。",
   "file": "voice/sim9/n32.wav"
  },
  {
   "n": 33,
   "at": 127.631,
   "dur": 3.861,
   "text": "たとえば、江戸時代の刀の飾りの技、木目金。",
   "file": "voice/sim9/n33.wav"
  },
  {
   "n": 34,
   "at": 131.783,
   "dur": 3.307,
   "text": "一時途絶えたとされ、のちに復元されました。",
   "file": "voice/sim9/n34.wav"
  },
  {
   "n": 35,
   "at": 135.291,
   "dur": 7.616,
   "text": "途切れた技を組み立て直すときは、残った手がかりと、職人の帳面や記録を Claude に渡します。",
   "file": "voice/sim9/n35.wav"
  },
  {
   "n": 36,
   "at": 142.958,
   "dur": 4.992,
   "text": "力を試すために、作り方を隠して、手がかりだけを渡しました。",
   "file": "voice/sim9/n36.wav"
  },
  {
   "n": 37,
   "at": 147.924,
   "dur": 5.269,
   "text": "隠しておいた、本当の 11 の手順と比べると、9 に、たどり着きました。",
   "file": "voice/sim9/n37.wav"
  },
  {
   "n": 38,
   "at": 154.297,
   "dur": 2.731,
   "text": "手がかりだけでも、ここまで届きます。",
   "file": "voice/sim9/n38.wav"
  },
  {
   "n": 39,
   "at": 157.391,
   "dur": 5.845,
   "text": "職人の帳面が加われば、失われた技も、組み立て直せるかもしれません。",
   "file": "voice/sim9/n39.wav"
  },
  {
   "n": 40,
   "at": 163.331,
   "dur": 4.117,
   "text": "なので、工房に入れておけば、万が一の時に役立ちます。",
   "file": "voice/sim9/n40.wav"
  },
  {
   "n": 41,
   "at": 169.776,
   "dur": 2.112,
   "text": "職人の判断を、次の人へ。",
   "file": "voice/sim9/n41.wav"
  },
  {
   "n": 42,
   "at": 172.621,
   "dur": 0.683,
   "text": "継ぐ。",
   "file": "voice/sim9/n42.wav"
  },
  {
   "n": 43,
   "at": 174.136,
   "dur": 3.541,
   "text": "このアプリも、私が Claude Code と作りました。",
   "file": "voice/sim9/n43.wav"
  }
 ],
