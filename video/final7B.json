 "voice": [
  {
   "n": 1,
   "at": 0.5,
   "text": "私は、彫金の職人です。",
   "own": "voice/sim7/_own/n1.wav",
   "own_raw": 2.581,
   "own_dur": 2.581
  },
  {
   "n": 2,
   "at": 8.5,
   "text": "作れるかどうかの判断は、職人の頭の中にしかない。",
   "own": "voice/sim7/_own/n2.wav",
   "own_raw": 4.501,
   "own_dur": 4.501
  },
  {
   "n": 3,
   "at": 20.5,
   "text": "継ぐは、それを蓄えます。",
   "own": "voice/sim7/_own/n3.wav",
   "own_raw": 1.770667,
   "own_dur": 1.770667
  },
  {
   "n": 4,
   "at": 25,
   "text": "作れない、と何度もデザインに戻ってくる。",
   "own": "voice/sim7/_own/n4.wav",
   "own_raw": 3.093,
   "own_dur": 3.093
  },
  {
   "n": 5,
   "at": 33,
   "text": "継ぐなら、デザインの時点で、作れるか分かる。",
   "own": "voice/sim7/_own/n5.wav",
   "own_raw": 3.093,
   "own_dur": 3.093
  },
  {
   "n": 6,
   "at": 41,
   "text": "ネットの情報だけだと、不自然な形になる。",
   "own": "voice/sim7/_own/n6.wav",
   "own_raw": 3.605,
   "own_dur": 3.605
  },
  {
   "n": 7,
   "at": 49,
   "text": "職人の言葉を、そのまま入れる。",
   "own": "voice/sim7/_own/n7.wav",
   "own_raw": 2.453,
   "own_dur": 2.453
  },
  {
   "n": 8,
   "at": 57,
   "text": "Claude が、それを決まりにする。",
   "own": "voice/sim7/_own/n8.wav",
   "own_raw": 2.176,
   "own_dur": 2.176
  },
  {
   "n": 9,
   "at": 68.5,
   "text": "職人の言葉で、爪も、石座のデザインも変わった。",
   "own": "voice/sim7/_own/n9.wav",
   "own_raw": 4.074667,
   "own_dur": 4.074667
  },
  {
   "n": 10,
   "at": 81,
   "text": "これまでの作品も、その決まりで確かめ直す。",
   "own": "voice/sim7/_own/n10.wav",
   "own_raw": 3.712,
   "own_dur": 3.712
  },
  {
   "n": 11,
   "at": 88.5,
   "text": "この作品の爪が、細すぎた。",
   "own": "voice/sim7/_own/n11.wav",
   "own_raw": 2.432,
   "own_dur": 2.432
  },
  {
   "n": 12,
   "at": 94.5,
   "text": "まとめて直す。",
   "own": "voice/sim7/_own/n12.wav",
   "own_raw": 1.258667,
   "own_dur": 1.258667
  },
  {
   "n": 13,
   "at": 101,
   "text": "帳面に足りない所は、Claude が聞きに来る。",
   "own": "voice/sim7/_own/n13.wav",
   "own_raw": 3.370667,
   "own_dur": 3.370667
  },
  {
   "n": 14,
   "at": 113,
   "text": "答えると、それが決まりになる。",
   "own": "voice/sim7/_own/n14.wav",
   "own_raw": 2.304,
   "own_dur": 2.304
  },
  {
   "n": 16,
   "at": 121,
   "text": "腕に尖った所があると、赤く点滅して、作れないと分かる。",
   "own": "voice/sim7/_own/n16.wav",
   "own_raw": 5.056,
   "own_dur": 5.056
  },
  {
   "n": 17,
   "at": 131.5,
   "text": "直すと、消える。",
   "own": "voice/sim7/_own/n17.wav",
   "own_raw": 1.173,
   "own_dur": 1.173
  },
  {
   "n": 18,
   "at": 137,
   "text": "形から、作り方まで出る。",
   "own": "voice/sim7/_own/n18.wav",
   "own_raw": 2.368,
   "own_dur": 2.368
  },
  {
   "n": 19,
   "at": 145,
   "text": "職人の言葉は、その工程に残る。",
   "own": "voice/sim7/_own/n19.wav",
   "own_raw": 3.093,
   "own_dur": 3.093
  },
  {
   "n": 20,
   "at": 153,
   "text": "独自のデザインは、先生に聞くしかない。",
   "own": "voice/sim7/_own/n20.wav",
   "own_raw": 3.008,
   "own_dur": 3.008
  },
  {
   "n": 21,
   "at": 160,
   "text": "生徒は多く、先生は少ない。長いときは 1 時間待つ。",
   "own": "voice/sim7/_own/n21.wav",
   "own_raw": 4.522667,
   "own_dur": 4.522667
  },
  {
   "n": 22,
   "at": 169,
   "text": "継ぐなら、すぐ答えが出る。",
   "own": "voice/sim7/_own/n22.wav",
   "own_raw": 1.877,
   "own_dur": 1.877
  },
  {
   "n": 23,
   "at": 177,
   "text": "工房では、順番や数字は継ぐに聞く。",
   "own": "voice/sim7/_own/n23.wav",
   "own_raw": 2.901,
   "own_dur": 2.901
  },
  {
   "n": 24,
   "at": 185,
   "text": "先輩には、まだ言葉にできない手の感覚を。",
   "own": "voice/sim7/_own/n24.wav",
   "own_raw": 3.648,
   "own_dur": 3.648
  },
  {
   "n": 25,
   "at": 193,
   "text": "そして、伝統工芸の継承にも使える。",
   "own": "voice/sim7/_own/n25.wav",
   "own_raw": 2.965,
   "own_dur": 2.965
  },
  {
   "n": 26,
   "at": 201,
   "text": "伝統的工芸品の作り手は、約 6 割減った。",
   "own": "voice/sim7/_own/n26.wav",
   "own_raw": 4.309,
   "own_dur": 4.309
  },
  {
   "n": 27,
   "at": 213,
   "text": "20 年に一度しか、受け継ぐ機会がない技もある。",
   "own": "voice/sim7/_own/n27.wav",
   "own_raw": 3.989,
   "own_dur": 3.989
  },
  {
   "n": 28,
   "at": 225,
   "text": "彫金・金工は、ジュエリーと同じ技。",
   "own": "voice/sim7/_own/n28.wav",
   "own_raw": 3.050667,
   "own_dur": 3.050667
  },
  {
   "n": 29,
   "at": 232.5,
   "text": "もし、途絶えてしまっても。",
   "own": "voice/sim7/_own/n29.wav",
   "own_raw": 1.664,
   "own_dur": 1.664
  },
  {
   "n": 30,
   "at": 237,
   "text": "木目金は、江戸時代の刀の飾りの技。",
   "own": "voice/sim7/_own/n30.wav",
   "own_raw": 3.690667,
   "own_dur": 3.690667
  },
  {
   "n": 31,
   "at": 245,
   "text": "一時途絶えたとされ、のちに復元された。",
   "own": "voice/sim7/_own/n31.wav",
   "own_raw": 3.306667,
   "own_dur": 3.306667
  },
  {
   "n": 32,
   "at": 253,
   "text": "作り方を隠して、手がかりだけを渡す。",
   "own": "voice/sim7/_own/n32.wav",
   "own_raw": 3.264,
   "own_dur": 3.264
  },
  {
   "n": 33,
   "at": 261,
   "text": "Claude が、作り方の復元を試みる。",
   "own": "voice/sim7/_own/n33.wav",
   "own_raw": 3.072,
   "own_dur": 3.072
  },
  {
   "n": 34,
   "at": 269,
   "text": "隠しておいた、本当の 11 の手順と比べる。",
   "own": "voice/sim7/_own/n34.wav",
   "own_raw": 3.52,
   "own_dur": 3.52
  },
  {
   "n": 35,
   "at": 280.5,
   "text": "11 のうち 9 に、たどり着いた。",
   "own": "voice/sim7/_own/n35.wav",
   "own_raw": 2.368,
   "own_dur": 2.368
  },
  {
   "n": 36,
   "at": 293,
   "text": "失われた技も、手がかりから組み立て直せるかもしれない。",
   "own": "voice/sim7/_own/n36.wav",
   "own_raw": 4.629,
   "own_dur": 4.629
  },
  {
   "n": 37,
   "at": 305,
   "text": "職人の判断を、蓄える。",
   "own": "voice/sim7/_own/n37.wav",
   "own_raw": 1.898667,
   "own_dur": 1.898667
  },
  {
   "n": 38,
   "at": 313,
   "text": "失われた技まで、組み立て直す。",
   "own": "voice/sim7/_own/n38.wav",
   "own_raw": 2.688,
   "own_dur": 2.688
  },
  {
   "n": 39,
   "at": 326.4,
   "text": "継ぐ。",
   "own": "voice/sim7/_own/n39.wav",
   "own_raw": 0.715,
   "own_dur": 0.715
  },
