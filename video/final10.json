 "voice": [
  {
   "n": 1,
   "at": 2.2,
   "dur": 2.581,
   "text": "私は、彫金の職人です。",
   "file": "voice/sim10/n1.wav"
  },
  {
   "n": 2,
   "at": 6.067,
   "dur": 4.544,
   "text": "作れるかどうかの判断は、職人の頭の中にあります。",
   "file": "voice/sim10/n2.wav"
  },
  {
   "n": 3,
   "at": 11.9,
   "dur": 3.328,
   "text": "職人がいなくなれば、その判断も消えます。",
   "file": "voice/sim10/n3.wav"
  },
  {
   "n": 42,
   "at": 17.333,
   "dur": 0.725,
   "text": "継ぐ。",
   "file": "voice/sim10/n42.wav"
  },
  {
   "n": 41,
   "at": 19.258,
   "dur": 2.24,
   "text": "職人の判断を、次の人へ。",
   "file": "voice/sim10/n41.wav"
  },
  {
   "n": 5,
   "at": 23.2,
   "dur": 2.965,
   "text": "職人は、ふだんの言葉で話すだけ。",
   "file": "voice/sim10/n5.wav"
  },
  {
   "n": 6,
   "at": 26.665,
   "dur": 3.947,
   "text": "Claude が、それを数字のついた決まりに書き直します。",
   "file": "voice/sim10/n6.wav"
  },
  {
   "n": 7,
   "at": 31.112,
   "dur": 2.837,
   "text": "職人がよければ、帳面に残ります。",
   "file": "voice/sim10/n7.wav"
  },
  {
   "n": 10,
   "at": 40.065,
   "dur": 1.621,
   "text": "まず、デザインする人へ。",
   "file": "voice/sim10/n10.wav"
  },
  {
   "n": 11,
   "at": 41.933,
   "dur": 4.309,
   "text": "作れない、と制作から何度も戻ってくることがあります。",
   "file": "voice/sim10/n11.wav"
  },
  {
   "n": 13,
   "at": 60.981,
   "dur": 5.44,
   "text": "職人が残した言葉をもとに、Claude が、次の指輪を組みます。",
   "file": "voice/sim10/n13.wav"
  },
  {
   "n": 15,
   "at": 69.0,
   "dur": 7.189,
   "text": "「アールデコな感じ」と打ち込むだけで、職人の決まりを守った、作れる形が出てきます。",
   "file": "voice/sim10/n15.wav"
  },
  {
   "n": 18,
   "at": 80.233,
   "dur": 3.499,
   "text": "作れない所は、職人の言葉で教えます。",
   "file": "voice/sim10/n18.wav"
  },
  {
   "n": 19,
   "at": 84.632,
   "dur": 3.008,
   "text": "なぜ作れないのか、どう直せばよいのかを。",
   "file": "voice/sim10/n19.wav"
  },
  {
   "n": 20,
   "at": 93.433,
   "dur": 6.4,
   "text": "3D モデルをもとに、鋳造でも鍛造でも、作り方を自動で作成します。",
   "file": "voice/sim10/n20.wav"
  },
  {
   "n": 21,
   "at": 100.965,
   "dur": 1.557,
   "text": "次に、学ぶ人へ。",
   "file": "voice/sim10/n21.wav"
  },
  {
   "n": 22,
   "at": 102.432,
   "dur": 4.309,
   "text": "学校では、独自のデザインは、先生に聞くしかありません。",
   "file": "voice/sim10/n22.wav"
  },
  {
   "n": 23,
   "at": 107.379,
   "dur": 4.757,
   "text": "先生は少なく、長いときは 1 時間ほど待つこともあります。",
   "file": "voice/sim10/n23.wav"
  },
  {
   "n": 24,
   "at": 114.767,
   "dur": 1.984,
   "text": "継ぐなら、すぐ答えが出ます。",
   "file": "voice/sim10/n24.wav"
  },
  {
   "n": 27,
   "at": 119.999,
   "dur": 1.792,
   "text": "そして、次の時代へ。",
   "file": "voice/sim10/n27.wav"
  },
  {
   "n": 28,
   "at": 122.073,
   "dur": 4.693,
   "text": "伝統的工芸品の作り手は、約 6 割減りました。",
   "file": "voice/sim10/n28.wav"
  },
  {
   "n": 29,
   "at": 126.565,
   "dur": 4.331,
   "text": "20 年に一度しか、受け継ぐ機会がない技もあります。",
   "file": "voice/sim10/n29.wav"
  },
  {
   "n": 30,
   "at": 131.267,
   "dur": 3.904,
   "text": "こうした彫金の技も、継ぐで、次へ残せます。",
   "file": "voice/sim10/n30.wav"
  },
  {
   "n": 32,
   "at": 141.428,
   "dur": 4.331,
   "text": "もし途絶えてしまっても、復元を試みることができます。",
   "file": "voice/sim10/n32.wav"
  },
  {
   "n": 33,
   "at": 146.048,
   "dur": 4.181,
   "text": "たとえば、江戸時代の刀の飾りの技、木目金。",
   "file": "voice/sim10/n33.wav"
  },
  {
   "n": 37,
   "at": 151.3,
   "dur": 5.675,
   "text": "隠しておいた、本当の 11 の手順と比べると、9 に、たどり着きました。",
   "file": "voice/sim10/n37.wav"
  },
  {
   "n": 39,
   "at": 158.575,
   "dur": 6.4,
   "text": "職人の帳面が加われば、失われた技も、組み立て直せるかもしれません。",
   "file": "voice/sim10/n39.wav"
  },
  {
   "n": 42,
   "at": 168.267,
   "dur": 0.725,
   "text": "継ぐ。",
   "file": "voice/sim10/n42.wav"
  },
  {
   "n": 41,
   "at": 170.192,
   "dur": 2.24,
   "text": "職人の判断を、次の人へ。",
   "file": "voice/sim10/n41.wav"
  },
