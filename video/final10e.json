 "voice": [
  {
   "n": 1,
   "at": 1.9,
   "dur": 2.269,
   "text": "私は、彫金の職人です。",
   "file": "voice/_own10_pro/n1.wav"
  },
  {
   "n": 2,
   "at": 5.167,
   "dur": 3.785,
   "text": "作れるかどうかの判断は、職人の頭の中にあります。",
   "file": "voice/_own10_pro/n2.wav"
  },
  {
   "n": 3,
   "at": 9.967,
   "dur": 3.669,
   "text": "職人がいなくなれば、その判断も消えます。",
   "file": "voice/_own10_pro/n3.wav"
  },
  {
   "n": 42,
   "at": 15.133,
   "dur": 1.351,
   "text": "継ぐ。",
   "file": "voice/_own10_pro/n42.wav"
  },
  {
   "n": 41,
   "at": 17.684,
   "dur": 2.454,
   "text": "職人の判断を、次の人へ。",
   "file": "voice/_own10_pro/n41.wav"
  },
  {
   "n": 5,
   "at": 21.1,
   "dur": 2.031,
   "text": "職人は、ふだんの言葉で話すだけ。",
   "file": "voice/_own10_pro/n5.wav"
  },
  {
   "n": 6,
   "at": 23.581,
   "dur": 4.973,
   "text": "Claude が決まりにし、ほかの設計も、帳面をもとに計算します。",
   "file": "voice/_own10_pro/n6.wav"
  },
  {
   "n": 7,
   "at": 29.003,
   "dur": 2.855,
   "text": "職人がよければ、帳面に残ります。",
   "file": "voice/_own10_pro/n7.wav"
  },
  {
   "n": 8,
   "at": 33.167,
   "dur": 2.72,
   "text": "違えば、ひとこと話すだけで直せます。",
   "file": "voice/_own10_pro/n8.wav"
  },
  {
   "n": 10,
   "at": 37.783,
   "dur": 1.9,
   "text": "まず、デザインする人へ。",
   "file": "voice/_own10_pro/n10.wav"
  },
  {
   "n": 11,
   "at": 40.8,
   "dur": 4.832,
   "text": "作れない、と制作から何度も戻ってくることがあります。",
   "file": "voice/_own10_pro/n11.wav"
  },
  {
   "n": 12,
   "at": 47.932,
   "dur": 4.545,
   "text": "継ぐがあれば、制作から戻ることは、ごく少なくなります。",
   "file": "voice/_own10_pro/n12.wav"
  },
  {
   "n": 13,
   "at": 58.793,
   "dur": 5.412,
   "text": "職人が残した言葉をもとに、Claude が、作れる指輪を自動で組みます。",
   "file": "voice/_own10_pro/n13.wav"
  },
  {
   "n": 15,
   "at": 66.45,
   "dur": 6.97,
   "text": "好きな雰囲気や細かい希望を打ち込むだけで、職人の決まりを守った、作れる形が出てきます。",
   "file": "voice/_own10_pro/n15.wav"
  },
  {
   "n": 18,
   "at": 77.533,
   "dur": 3.102,
   "text": "作れない所は、職人の言葉で教えます。",
   "file": "voice/_own10_pro/n18.wav"
  },
  {
   "n": 19,
   "at": 81.335,
   "dur": 3.161,
   "text": "なぜ作れないのか、どう直せばよいのかを。",
   "file": "voice/_own10_pro/n19.wav"
  },
  {
   "n": 21,
   "at": 95.9,
   "dur": 1.923,
   "text": "次に、学ぶ人へ。",
   "file": "voice/_own10_pro/n21.wav"
  },
  {
   "n": 20,
   "at": 99.433,
   "dur": 6.292,
   "text": "鋳造でも鍛造でも、3D モデルと帳面の言葉から、作り方を自動で出します。",
   "file": "voice/_own10_pro/n20.wav"
  },
  {
   "n": 22,
   "at": 106.667,
   "dur": 3.527,
   "text": "学校では、独自のデザインの作り方は、先生に聞くしかありません。",
   "file": "voice/_own10_pro/n22.wav"
  },
  {
   "n": 23,
   "at": 110.644,
   "dur": 5.566,
   "text": "先生が確かめられる数には限りがあり、1 時間ほど待つこともあります。",
   "file": "voice/_own10_pro/n23.wav"
  },
  {
   "n": 24,
   "at": 118.167,
   "dur": 2.174,
   "text": "継ぐなら、すぐ答えが出ます。",
   "file": "voice/_own10_pro/n24.wav"
  },
  {
   "n": 27,
   "at": 121.633,
   "dur": 1.927,
   "text": "そして、次の時代へ。",
   "file": "voice/_own10_pro/n27.wav"
  },
  {
   "n": 28,
   "at": 124.467,
   "dur": 3.565,
   "text": "伝統的工芸品の作り手は、約 6 割減りました。",
   "file": "voice/_own10_pro/n28.wav"
  },
  {
   "n": 29,
   "at": 129.067,
   "dur": 3.833,
   "text": "20 年に一度しか、受け継ぐ機会がない技もあります。",
   "file": "voice/_own10_pro/n29.wav"
  },
  {
   "n": 30,
   "at": 133.75,
   "dur": 4.374,
   "text": "こうした彫金の技も、継ぐで、次へ残せます。",
   "file": "voice/_own10_pro/n30.wav"
  },
  {
   "n": 32,
   "at": 142.883,
   "dur": 4.038,
   "text": "もし途絶えてしまっても、復元を試みることができます。",
   "file": "voice/_own10_pro/n32.wav"
  },
  {
   "n": 33,
   "at": 147.671,
   "dur": 4.239,
   "text": "たとえば、江戸時代の刀の飾りの技、木目金。",
   "file": "voice/_own10_pro/n33.wav"
  },
  {
   "n": 37,
   "at": 153.717,
   "dur": 5.312,
   "text": "隠しておいた、本当の 11 の手順と比べると、9 に、たどり着きました。",
   "file": "voice/_own10_pro/n37.wav"
  },
  {
   "n": 39,
   "at": 161.729,
   "dur": 5.85,
   "text": "職人の帳面が加われば、失われた技も、組み立て直せるかもしれません。",
   "file": "voice/_own10_pro/n39.wav"
  },
